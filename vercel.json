{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "kavuthamraj-website-red.vercel.app"
        }
      ],
      "destination": "https://www.kavuthamraj.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kavuthamraj-website-red.vercel.app"
        }
      ],
      "destination": "https://www.kavuthamraj.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(styles\\.css|main\\.js)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|mp4|jpg|png|ico|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
